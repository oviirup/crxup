{
  "name": "crxup-root",
  "type": "module",
  "private": true,
  "workspaces": [
    "docs/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "format": "prettier . -wu --cache",
    "format:check": "prettier . -cu",
    "lint": "turbo run lint --parallel",
    "lint:repo": "npx sherif"
  },
  "devDependencies": {
    "turbo": "~2.5.0",
    "typescript": "~5.8.3",
    "vitest": "~3.1.1"
  }
}
